rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function hasGitHubIdentity() {
      return request.auth != null
        && request.auth.token.firebase is map
        && request.auth.token.firebase.identities is map
        && request.auth.token.firebase.identities.keys().hasAll(['github.com'])
        && request.auth.token.firebase.identities['github.com'] is list
        && request.auth.token.firebase.identities['github.com'].size() == 1
        && request.auth.token.firebase.identities['github.com'][0] is string
        && request.auth.token.firebase.identities['github.com'][0].matches('^[0-9]+$');
    }

    function githubUserId() {
      return request.auth.token.firebase.identities['github.com'][0];
    }

    function seasonOneDocumentId() {
      return '1_' + githubUserId();
    }

    function contributorPath() {
      return /databases/$(database)/documents/contributors/$(githubUserId());
    }

    function contributorPathFor(id) {
      return /databases/$(database)/documents/contributors/$(id);
    }

    function participationPath() {
      return /databases/$(database)/documents/participation/$(seasonOneDocumentId());
    }

    function participationPathFor(id) {
      let documentId = '1_' + id;
      return /databases/$(database)/documents/participation/$(documentId);
    }

    function queuePath() {
      return /databases/$(database)/documents/queue/$(seasonOneDocumentId());
    }

    function queuePathFor(id) {
      let documentId = '1_' + id;
      return /databases/$(database)/documents/queue/$(documentId);
    }

    function adminPath() {
      return /databases/$(database)/documents/admins/$(githubUserId());
    }

    function turnPath(turnId) {
      return /databases/$(database)/documents/turns/$(turnId);
    }

    function privateSitePath() {
      return /databases/$(database)/documents/site/admin;
    }

    function publicSitePath() {
      return /databases/$(database)/documents/site/public;
    }

    function isActiveAdmin() {
      return hasGitHubIdentity()
        && exists(adminPath())
        && get(adminPath()).data.githubUserId == githubUserId()
        && get(adminPath()).data.active == true
        && (get(adminPath()).data.role == 'owner' || get(adminPath()).data.role == 'admin');
    }

    // A self-service join is valid only when all three documents are new before
    // the request and all three exist after the same atomic transaction.
    function isCompleteNewJoin() {
      return !exists(contributorPath())
        && !exists(participationPath())
        && !exists(queuePath())
        && existsAfter(contributorPath())
        && existsAfter(participationPath())
        && existsAfter(queuePath());
    }

    function hasJoinTimestamps(data) {
      return data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validContributor(data) {
      return data.keys().hasAll([
          'firebaseUid', 'githubUserId', 'githubUsername', 'displayName',
          'email', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'firebaseUid', 'githubUserId', 'githubUsername', 'displayName',
          'email', 'socialUrl', 'createdAt', 'updatedAt'
        ])
        && data.firebaseUid is string
        && data.firebaseUid == request.auth.uid
        && data.githubUserId is string
        && data.githubUserId == githubUserId()
        // Username is presentation metadata from sign-in. It is never authorization.
        && data.githubUsername is string
        && data.githubUsername.size() >= 1
        && data.githubUsername.size() <= 39
        && data.githubUsername.matches('^[A-Za-z0-9-]+$')
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 50
        && data.displayName.matches('^\\S(.*\\S)?$')
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.email.matches('^[^@ ]+@[^@ ]+\\.[^@ ]+$')
        && (!('socialUrl' in data)
          || (data.socialUrl is string
            && data.socialUrl.size() >= 1
            && data.socialUrl.size() <= 2048
            && data.socialUrl.matches('^https?://[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+(:[0-9]{1,5})?([/?#][^ ]*)?$')))
        && hasJoinTimestamps(data);
    }

    function validParticipation(data) {
      return data.keys().hasAll(['githubUserId', 'season', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['githubUserId', 'season', 'status', 'createdAt', 'updatedAt'])
        && data.githubUserId is string
        && data.githubUserId == githubUserId()
        && data.season is int
        && data.season == 1
        && data.status == 'waiting'
        && hasJoinTimestamps(data);
    }

    function validQueueEntry(data) {
      return data.keys().hasAll([
          'githubUserId', 'season', 'status', 'joinedAt', 'priority', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'githubUserId', 'season', 'status', 'joinedAt', 'priority', 'updatedAt'
        ])
        && data.githubUserId is string
        && data.githubUserId == githubUserId()
        && data.season is int
        && data.season == 1
        && data.status == 'waiting'
        && data.priority is int
        && data.priority == 0
        && data.joinedAt is timestamp
        && data.updatedAt is timestamp
        && data.joinedAt == request.time
        && data.updatedAt == request.time;
    }

    function validAdminQueuePriorityUpdate() {
      return resource.data.status == 'waiting'
        && request.resource.data.keys().hasAll([
          'githubUserId', 'season', 'status', 'joinedAt', 'priority', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'githubUserId', 'season', 'status', 'joinedAt', 'priority',
          'sortOrder', 'promotedAt', 'updatedAt'
        ])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['priority', 'promotedAt', 'updatedAt'])
        && request.resource.data.githubUserId == resource.data.githubUserId
        && request.resource.data.season == resource.data.season
        && request.resource.data.season == 1
        && request.resource.data.status == resource.data.status
        && request.resource.data.joinedAt == resource.data.joinedAt
        && request.resource.data.priority is int
        && request.resource.data.priority >= 0
        && request.resource.data.priority <= 2147483647
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.priority == 0
            && !('promotedAt' in request.resource.data))
          || (request.resource.data.priority > resource.data.priority
            && request.resource.data.promotedAt is timestamp
            && request.resource.data.promotedAt == request.time));
    }

    function noActiveTurnBefore() {
      return (!exists(privateSitePath()) || get(privateSitePath()).data.activeTurnId == null)
        && (!exists(publicSitePath()) || get(publicSitePath()).data.turnStatus == 'none');
    }

    function currentVersionBefore() {
      return exists(publicSitePath()) ? get(publicSitePath()).data.currentVersion : 0;
    }

    function totalContributionsBefore() {
      return exists(publicSitePath()) ? get(publicSitePath()).data.totalContributions : 0;
    }

    function validTurnCreate() {
      let data = request.resource.data;
      return noActiveTurnBefore()
        && data.keys().hasAll([
          'githubUserId', 'season', 'status', 'targetContributionNumber',
          'startedAt', 'dueAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'githubUserId', 'season', 'status', 'targetContributionNumber',
          'startedAt', 'dueAt', 'createdAt', 'updatedAt'
        ])
        && data.githubUserId is string
        && data.githubUserId.matches('^[0-9]+$')
        && data.season == 1
        && data.status == 'active'
        && data.targetContributionNumber is int
        && data.targetContributionNumber > 0
        && data.targetContributionNumber == currentVersionBefore() + 1
        && data.startedAt is timestamp
        && data.startedAt == request.time
        && data.dueAt is timestamp
        && data.dueAt > request.time
        && data.createdAt is timestamp
        && data.createdAt == request.time
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function validParticipationActivation(participationDocument) {
      return participationDocument == '1_' + resource.data.githubUserId
        && resource.data.season == 1
        && resource.data.status == 'waiting'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'active'
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time
        && completeActivation(getAfter(privateSitePath()).data.activeTurnId, resource.data.githubUserId);
    }

    function validQueueActivation(queueDocument) {
      return queueDocument == '1_' + resource.data.githubUserId
        && resource.data.season == 1
        && resource.data.status == 'waiting'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'active'
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time
        && completeActivation(getAfter(privateSitePath()).data.activeTurnId, resource.data.githubUserId);
    }

    function validPrivateSiteActivation() {
      return noActiveTurnBefore()
        && request.resource.data.keys().hasAll(['activeTurnId', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['activeTurnId', 'updatedAt'])
        && request.resource.data.activeTurnId is string
        && request.resource.data.activeTurnId.size() >= 1
        && request.resource.data.activeTurnId.size() <= 128
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time
        && completeActivation(
          request.resource.data.activeTurnId,
          getAfter(turnPath(request.resource.data.activeTurnId)).data.githubUserId
        );
    }

    function validPublicSiteActivation() {
      let data = request.resource.data;
      let turnId = getAfter(privateSitePath()).data.activeTurnId;
      let turn = getAfter(turnPath(turnId)).data;
      let contributor = getAfter(contributorPathFor(turn.githubUserId)).data;
      return noActiveTurnBefore()
        && data.keys().hasAll([
          'currentVersion', 'totalContributions', 'turnStatus',
          'targetContributionNumber', 'currentContributor', 'dueAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'currentVersion', 'totalContributions', 'turnStatus',
          'targetContributionNumber', 'currentContributor', 'dueAt', 'updatedAt'
        ])
        && data.currentVersion is int
        && data.currentVersion >= 0
        && data.currentVersion == currentVersionBefore()
        && data.totalContributions is int
        && data.totalContributions >= 0
        && data.totalContributions == totalContributionsBefore()
        && data.turnStatus == 'active'
        && data.targetContributionNumber == data.currentVersion + 1
        && data.targetContributionNumber == turn.targetContributionNumber
        && data.currentContributor is map
        && data.currentContributor.keys().hasAll(['githubUsername', 'displayName'])
        && data.currentContributor.keys().hasOnly(['githubUsername', 'displayName'])
        && data.currentContributor.githubUsername is string
        && data.currentContributor.githubUsername.size() >= 1
        && data.currentContributor.githubUsername.size() <= 39
        && data.currentContributor.githubUsername.matches('^[A-Za-z0-9-]+$')
        && data.currentContributor.displayName is string
        && data.currentContributor.displayName.size() >= 1
        && data.currentContributor.displayName.size() <= 50
        && data.currentContributor.displayName.matches('^\\S(.*\\S)?$')
        && data.currentContributor.githubUsername == contributor.githubUsername
        && data.currentContributor.displayName == contributor.displayName
        && data.dueAt is timestamp
        && data.dueAt == turn.dueAt
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && completeActivation(turnId, turn.githubUserId);
    }

    // Every permitted activation write requires one internally consistent final state.
    // This prevents a browser from manufacturing a turn or isolated status transition.
    function completeActivation(turnId, id) {
      return turnId is string
        && turnId.size() >= 1
        && existsAfter(turnPath(turnId))
        && existsAfter(contributorPathFor(id))
        && existsAfter(participationPathFor(id))
        && existsAfter(queuePathFor(id))
        && existsAfter(privateSitePath())
        && existsAfter(publicSitePath())
        && getAfter(turnPath(turnId)).data.githubUserId == id
        && getAfter(turnPath(turnId)).data.status == 'active'
        && getAfter(participationPathFor(id)).data.githubUserId == id
        && getAfter(participationPathFor(id)).data.season == 1
        && getAfter(participationPathFor(id)).data.status == 'active'
        && getAfter(queuePathFor(id)).data.githubUserId == id
        && getAfter(queuePathFor(id)).data.season == 1
        && getAfter(queuePathFor(id)).data.status == 'active'
        && getAfter(privateSitePath()).data.activeTurnId == turnId
        && getAfter(publicSitePath()).data.turnStatus == 'active'
        && getAfter(publicSitePath()).data.targetContributionNumber
          == getAfter(turnPath(turnId)).data.targetContributionNumber
        && getAfter(publicSitePath()).data.dueAt == getAfter(turnPath(turnId)).data.dueAt;
    }

    match /contributions/{contributionNumber} {
      allow read: if true;
      allow write: if false;
    }

    match /site/public {
      allow read: if true;
      allow create, update: if isActiveAdmin() && validPublicSiteActivation();
      allow delete: if false;
    }

    match /site/admin {
      allow get: if isActiveAdmin();
      allow list: if false;
      allow create, update: if isActiveAdmin() && validPrivateSiteActivation();
      allow delete: if false;
    }

    match /admins/{adminGithubUserId} {
      allow get: if hasGitHubIdentity() && adminGithubUserId == githubUserId();
      allow list, create, update, delete: if false;
    }

    match /contributors/{githubUserIdDocument} {
      allow get: if (hasGitHubIdentity() && githubUserIdDocument == githubUserId())
        || isActiveAdmin();
      allow list: if isActiveAdmin();
      allow create: if hasGitHubIdentity()
        && githubUserIdDocument == githubUserId()
        && isCompleteNewJoin()
        && validContributor(request.resource.data);
      allow update, delete: if false;
    }

    match /participation/{participationDocument} {
      allow get: if (hasGitHubIdentity() && participationDocument == seasonOneDocumentId())
        || isActiveAdmin();
      allow list: if isActiveAdmin();
      allow create: if hasGitHubIdentity()
        && participationDocument == seasonOneDocumentId()
        && isCompleteNewJoin()
        && validParticipation(request.resource.data);
      allow update: if isActiveAdmin() && validParticipationActivation(participationDocument);
      allow delete: if false;
    }

    match /queue/{queueDocument} {
      allow get, list: if isActiveAdmin();
      allow create: if hasGitHubIdentity()
        && queueDocument == seasonOneDocumentId()
        && isCompleteNewJoin()
        && validQueueEntry(request.resource.data);
      allow update: if isActiveAdmin()
        && (validAdminQueuePriorityUpdate() || validQueueActivation(queueDocument));
      allow delete: if false;
    }

    match /turns/{turnId} {
      allow read: if isActiveAdmin();
      allow create: if isActiveAdmin()
        && validTurnCreate()
        && completeActivation(turnId, request.resource.data.githubUserId);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
