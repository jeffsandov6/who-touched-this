rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function hasGitHubIdentity() {
      return request.auth != null
        && request.auth.token.firebase is map
        && request.auth.token.firebase.identities is map
        && request.auth.token.firebase.identities.keys().hasAll(['github.com'])
        && request.auth.token.firebase.identities['github.com'] is list
        && request.auth.token.firebase.identities['github.com'].size() == 1
        && request.auth.token.firebase.identities['github.com'][0] is string
        && request.auth.token.firebase.identities['github.com'][0].matches('^[0-9]+$');
    }

    function githubUserId() {
      return request.auth.token.firebase.identities['github.com'][0];
    }

    function seasonOneDocumentId() {
      return '1_' + githubUserId();
    }

    function contributorPath() {
      return /databases/$(database)/documents/contributors/$(githubUserId());
    }

    function contributorPathFor(id) {
      return /databases/$(database)/documents/contributors/$(id);
    }

    function participationPath() {
      return /databases/$(database)/documents/participation/$(seasonOneDocumentId());
    }

    function participationPathFor(id) {
      let documentId = '1_' + id;
      return /databases/$(database)/documents/participation/$(documentId);
    }

    function queuePath() {
      return /databases/$(database)/documents/queue/$(seasonOneDocumentId());
    }

    function queuePathFor(id) {
      let documentId = '1_' + id;
      return /databases/$(database)/documents/queue/$(documentId);
    }

    function adminPath() {
      return /databases/$(database)/documents/admins/$(githubUserId());
    }

    function turnPath(turnId) {
      return /databases/$(database)/documents/turns/$(turnId);
    }

    function contributionPath(number) {
      let documentId = string(number);
      return /databases/$(database)/documents/contributions/$(documentId);
    }

    function historyEventPath(turnId) {
      return /databases/$(database)/documents/historyEvents/$(turnId);
    }

    function privateSitePath() {
      return /databases/$(database)/documents/site/admin;
    }

    function publicSitePath() {
      return /databases/$(database)/documents/site/public;
    }

    function isActiveAdmin() {
      return hasGitHubIdentity()
        && exists(adminPath())
        && get(adminPath()).data.githubUserId == githubUserId()
        && get(adminPath()).data.active == true
        && (get(adminPath()).data.role == 'owner' || get(adminPath()).data.role == 'admin');
    }

    // A self-service join is valid only when all three documents are new before
    // the request and all three exist after the same atomic transaction.
    function isCompleteNewJoin() {
      return !exists(contributorPath())
        && !exists(participationPath())
        && !exists(queuePath())
        && existsAfter(contributorPath())
        && existsAfter(participationPath())
        && existsAfter(queuePath());
    }

    function hasJoinTimestamps(data) {
      return data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validContributor(data) {
      return data.keys().hasAll([
          'firebaseUid', 'githubUserId', 'githubUsername', 'displayName',
          'email', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'firebaseUid', 'githubUserId', 'githubUsername', 'displayName',
          'email', 'socialUrl', 'createdAt', 'updatedAt'
        ])
        && data.firebaseUid is string
        && data.firebaseUid == request.auth.uid
        && data.githubUserId is string
        && data.githubUserId == githubUserId()
        // Username is presentation metadata from sign-in. It is never authorization.
        && data.githubUsername is string
        && data.githubUsername.size() >= 1
        && data.githubUsername.size() <= 39
        && data.githubUsername.matches('^[A-Za-z0-9-]+$')
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 50
        && data.displayName.matches('^\\S(.*\\S)?$')
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.email.matches('^[^@ ]+@[^@ ]+\\.[^@ ]+$')
        && (!('socialUrl' in data)
          || (data.socialUrl is string
            && data.socialUrl.size() >= 1
            && data.socialUrl.size() <= 2048
            && data.socialUrl.matches('^https?://[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+(:[0-9]{1,5})?([/?#][^ ]*)?$')))
        && hasJoinTimestamps(data);
    }

    function validParticipation(data) {
      return data.keys().hasAll(['githubUserId', 'season', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['githubUserId', 'season', 'status', 'createdAt', 'updatedAt'])
        && data.githubUserId is string
        && data.githubUserId == githubUserId()
        && data.season is int
        && data.season == 1
        && data.status == 'waiting'
        && hasJoinTimestamps(data);
    }

    function validQueueEntry(data) {
      return data.keys().hasAll([
          'githubUserId', 'season', 'status', 'joinedAt', 'priority', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'githubUserId', 'season', 'status', 'joinedAt', 'priority', 'updatedAt'
        ])
        && data.githubUserId is string
        && data.githubUserId == githubUserId()
        && data.season is int
        && data.season == 1
        && data.status == 'waiting'
        && data.priority is int
        && data.priority == 0
        && data.joinedAt is timestamp
        && data.updatedAt is timestamp
        && data.joinedAt == request.time
        && data.updatedAt == request.time;
    }

    function validAdminQueuePriorityUpdate() {
      return resource.data.status == 'waiting'
        && request.resource.data.keys().hasAll([
          'githubUserId', 'season', 'status', 'joinedAt', 'priority', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'githubUserId', 'season', 'status', 'joinedAt', 'priority',
          'sortOrder', 'promotedAt', 'updatedAt'
        ])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['priority', 'promotedAt', 'updatedAt'])
        && request.resource.data.githubUserId == resource.data.githubUserId
        && request.resource.data.season == resource.data.season
        && request.resource.data.season == 1
        && request.resource.data.status == resource.data.status
        && request.resource.data.joinedAt == resource.data.joinedAt
        && request.resource.data.priority is int
        && request.resource.data.priority >= 0
        && request.resource.data.priority <= 2147483647
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.priority == 0
            && !('promotedAt' in request.resource.data))
          || (request.resource.data.priority > resource.data.priority
            && request.resource.data.promotedAt is timestamp
            && request.resource.data.promotedAt == request.time));
    }

    function noActiveTurnBefore() {
      return (!exists(privateSitePath()) || get(privateSitePath()).data.activeTurnId == null)
        && (!exists(publicSitePath()) || get(publicSitePath()).data.turnStatus == 'none');
    }

    function currentVersionBefore() {
      return exists(publicSitePath()) ? get(publicSitePath()).data.currentVersion : 0;
    }

    function totalContributionsBefore() {
      return exists(publicSitePath()) ? get(publicSitePath()).data.totalContributions : 0;
    }

    function validTurnCreate() {
      let data = request.resource.data;
      return noActiveTurnBefore()
        && data.keys().hasAll([
          'githubUserId', 'season', 'status', 'targetContributionNumber',
          'startedAt', 'dueAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'githubUserId', 'season', 'status', 'targetContributionNumber',
          'startedAt', 'dueAt', 'createdAt', 'updatedAt'
        ])
        && data.githubUserId is string
        && data.githubUserId.matches('^[0-9]+$')
        && data.season == 1
        && data.status == 'active'
        && data.targetContributionNumber is int
        && data.targetContributionNumber > 0
        && data.targetContributionNumber == currentVersionBefore() + 1
        && data.startedAt is timestamp
        && data.startedAt == request.time
        && data.dueAt is timestamp
        && data.dueAt > request.time
        && data.createdAt is timestamp
        && data.createdAt == request.time
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function validParticipationActivation(participationDocument) {
      return participationDocument == '1_' + resource.data.githubUserId
        && resource.data.season == 1
        && resource.data.status == 'waiting'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'active'
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time
        && completeActivation(getAfter(privateSitePath()).data.activeTurnId, resource.data.githubUserId);
    }

    function validQueueActivation(queueDocument) {
      return queueDocument == '1_' + resource.data.githubUserId
        && resource.data.season == 1
        && resource.data.status == 'waiting'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'active'
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time
        && completeActivation(getAfter(privateSitePath()).data.activeTurnId, resource.data.githubUserId);
    }

    function validPrivateSiteActivation() {
      return noActiveTurnBefore()
        && request.resource.data.keys().hasAll(['activeTurnId', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['activeTurnId', 'updatedAt'])
        && request.resource.data.activeTurnId is string
        && request.resource.data.activeTurnId.size() >= 1
        && request.resource.data.activeTurnId.size() <= 128
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time
        && completeActivation(
          request.resource.data.activeTurnId,
          getAfter(turnPath(request.resource.data.activeTurnId)).data.githubUserId
        );
    }

    function validPublicSiteActivation() {
      let data = request.resource.data;
      let turnId = getAfter(privateSitePath()).data.activeTurnId;
      let turn = getAfter(turnPath(turnId)).data;
      let contributor = getAfter(contributorPathFor(turn.githubUserId)).data;
      return noActiveTurnBefore()
        && data.keys().hasAll([
          'currentVersion', 'totalContributions', 'turnStatus',
          'targetContributionNumber', 'currentContributor', 'dueAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'currentVersion', 'totalContributions', 'turnStatus',
          'targetContributionNumber', 'currentContributor', 'dueAt', 'updatedAt'
        ])
        && data.currentVersion is int
        && data.currentVersion >= 0
        && data.currentVersion == currentVersionBefore()
        && data.totalContributions is int
        && data.totalContributions >= 0
        && data.totalContributions == totalContributionsBefore()
        && data.turnStatus == 'active'
        && data.targetContributionNumber == data.currentVersion + 1
        && data.targetContributionNumber == turn.targetContributionNumber
        && data.currentContributor is map
        && data.currentContributor.keys().hasAll(['githubUsername', 'displayName'])
        && data.currentContributor.keys().hasOnly(['githubUsername', 'displayName'])
        && data.currentContributor.githubUsername is string
        && data.currentContributor.githubUsername.size() >= 1
        && data.currentContributor.githubUsername.size() <= 39
        && data.currentContributor.githubUsername.matches('^[A-Za-z0-9-]+$')
        && data.currentContributor.displayName is string
        && data.currentContributor.displayName.size() >= 1
        && data.currentContributor.displayName.size() <= 50
        && data.currentContributor.displayName.matches('^\\S(.*\\S)?$')
        && data.currentContributor.githubUsername == contributor.githubUsername
        && data.currentContributor.displayName == contributor.displayName
        && data.dueAt is timestamp
        && data.dueAt == turn.dueAt
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && completeActivation(turnId, turn.githubUserId);
    }

    // Every permitted activation write requires one internally consistent final state.
    // This prevents a browser from manufacturing a turn or isolated status transition.
    function completeActivation(turnId, id) {
      return turnId is string
        && turnId.size() >= 1
        && existsAfter(turnPath(turnId))
        && existsAfter(contributorPathFor(id))
        && existsAfter(participationPathFor(id))
        && existsAfter(queuePathFor(id))
        && existsAfter(privateSitePath())
        && existsAfter(publicSitePath())
        && getAfter(turnPath(turnId)).data.githubUserId == id
        && getAfter(turnPath(turnId)).data.status == 'active'
        && getAfter(participationPathFor(id)).data.githubUserId == id
        && getAfter(participationPathFor(id)).data.season == 1
        && getAfter(participationPathFor(id)).data.status == 'active'
        && getAfter(queuePathFor(id)).data.githubUserId == id
        && getAfter(queuePathFor(id)).data.season == 1
        && getAfter(queuePathFor(id)).data.status == 'active'
        && getAfter(privateSitePath()).data.activeTurnId == turnId
        && getAfter(publicSitePath()).data.turnStatus == 'active'
        && getAfter(publicSitePath()).data.targetContributionNumber
          == getAfter(turnPath(turnId)).data.targetContributionNumber
        && getAfter(publicSitePath()).data.dueAt == getAfter(turnPath(turnId)).data.dueAt;
    }

    function currentTurnIdBefore() { return get(privateSitePath()).data.activeTurnId; }

    function validPullRequest(data) {
      return data.prNumber is int && data.prNumber > 0
        && data.prUrl is string && data.prUrl.size() >= 1 && data.prUrl.size() <= 500
        && data.prUrl.matches('^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/' + string(data.prNumber) + '$');
    }

    function currentTurnBaseIsPreserved(before, after) {
      return after.githubUserId == before.githubUserId && after.season == before.season
        && after.season == 1 && after.targetContributionNumber == before.targetContributionNumber
        && after.startedAt == before.startedAt && after.dueAt == before.dueAt
        && after.createdAt == before.createdAt;
    }

    function validTurnSubmission(turnId) {
      let before = resource.data;
      let after = request.resource.data;
      return currentTurnIdBefore() == turnId && before.status == 'active' && after.status == 'submitted'
        && after.keys().hasAll(['githubUserId','season','status','targetContributionNumber','startedAt','dueAt','prNumber','prUrl','submittedAt','createdAt','updatedAt'])
        && after.keys().hasOnly(['githubUserId','season','status','targetContributionNumber','startedAt','dueAt','prNumber','prUrl','submittedAt','createdAt','updatedAt'])
        && after.diff(before).affectedKeys().hasOnly(['status','prNumber','prUrl','submittedAt','updatedAt'])
        && currentTurnBaseIsPreserved(before, after) && validPullRequest(after)
        && after.submittedAt is timestamp && after.submittedAt == request.time
        && after.updatedAt is timestamp && after.updatedAt == request.time
        && getAfter(privateSitePath()).data.activeTurnId == turnId
        && getAfter(publicSitePath()).data.turnStatus == 'submitted'
        && getAfter(publicSitePath()).data.targetContributionNumber == after.targetContributionNumber;
    }

    function validTurnReview(turnId) {
      let before = resource.data;
      let after = request.resource.data;
      return currentTurnIdBefore() == turnId && before.status == 'submitted' && after.status == 'under_review'
        && after.keys().hasAll(['githubUserId','season','status','targetContributionNumber','startedAt','dueAt','prNumber','prUrl','submittedAt','reviewStartedAt','createdAt','updatedAt'])
        && after.keys().hasOnly(['githubUserId','season','status','targetContributionNumber','startedAt','dueAt','prNumber','prUrl','submittedAt','reviewStartedAt','createdAt','updatedAt'])
        && after.diff(before).affectedKeys().hasOnly(['status','reviewStartedAt','updatedAt'])
        && currentTurnBaseIsPreserved(before, after) && after.prNumber == before.prNumber
        && after.prUrl == before.prUrl && after.submittedAt == before.submittedAt
        && validPullRequest(after) && after.reviewStartedAt is timestamp
        && after.reviewStartedAt == request.time && after.updatedAt is timestamp
        && after.updatedAt == request.time && getAfter(privateSitePath()).data.activeTurnId == turnId
        && getAfter(publicSitePath()).data.turnStatus == 'under_review';
    }

    function validPublicCurrentTransition() {
      let before = resource.data;
      let after = request.resource.data;
      let turnId = currentTurnIdBefore();
      let turnAfter = getAfter(turnPath(turnId)).data;
      return ((before.turnStatus == 'active' && after.turnStatus == 'submitted')
          || (before.turnStatus == 'submitted' && after.turnStatus == 'under_review'))
        && after.keys().hasAll(['currentVersion','totalContributions','turnStatus','targetContributionNumber','currentContributor','dueAt','updatedAt'])
        && after.keys().hasOnly(['currentVersion','totalContributions','turnStatus','targetContributionNumber','currentContributor','dueAt','updatedAt'])
        && after.diff(before).affectedKeys().hasOnly(['turnStatus','updatedAt'])
        && after.currentVersion == before.currentVersion && after.totalContributions == before.totalContributions
        && after.targetContributionNumber == before.targetContributionNumber
        && after.currentContributor == before.currentContributor && after.dueAt == before.dueAt
        && after.updatedAt is timestamp && after.updatedAt == request.time
        && getAfter(privateSitePath()).data.activeTurnId == turnId
        && turnAfter.status == after.turnStatus && turnAfter.targetContributionNumber == after.targetContributionNumber
        && turnAfter.dueAt == after.dueAt;
    }

    function validTerminalTurnFields(before, after) {
      return (before.status == 'active' && after.keys().hasOnly(['githubUserId','season','status','targetContributionNumber','startedAt','dueAt','endedAt','createdAt','updatedAt']))
        || (before.status == 'submitted' && after.keys().hasOnly(['githubUserId','season','status','targetContributionNumber','startedAt','dueAt','prNumber','prUrl','submittedAt','endedAt','createdAt','updatedAt']))
        || (before.status == 'under_review' && after.keys().hasOnly(['githubUserId','season','status','targetContributionNumber','startedAt','dueAt','prNumber','prUrl','submittedAt','reviewStartedAt','endedAt','createdAt','updatedAt']));
    }

    function validTurnEnd(turnId) {
      let before = resource.data;
      let after = request.resource.data;
      return currentTurnIdBefore() == turnId && before.status in ['active','submitted','under_review']
        && after.status in ['expired','skipped']
        && (after.status != 'expired' || (before.status == 'active' && request.time >= before.dueAt))
        && after.keys().hasAll(['githubUserId','season','status','targetContributionNumber','startedAt','dueAt','endedAt','createdAt','updatedAt'])
        && validTerminalTurnFields(before, after)
        && after.diff(before).affectedKeys().hasOnly(['status','endedAt','updatedAt'])
        && currentTurnBaseIsPreserved(before, after) && after.endedAt is timestamp
        && after.endedAt == request.time && after.updatedAt is timestamp && after.updatedAt == request.time
        && completeTurnEnd(turnId, before.githubUserId, after.status);
    }

    function completeTurnEnd(turnId, id, terminalStatus) {
      let event = getAfter(historyEventPath(turnId)).data;
      return !exists(historyEventPath(turnId))
        && getAfter(turnPath(turnId)).data.status == terminalStatus
        && getAfter(participationPathFor(id)).data.status == terminalStatus
        && getAfter(queuePathFor(id)).data.status == terminalStatus
        && getAfter(privateSitePath()).data.activeTurnId == null
        && getAfter(publicSitePath()).data.turnStatus == 'none'
        && getAfter(publicSitePath()).data.currentContributor == null
        && getAfter(publicSitePath()).data.targetContributionNumber == null
        && getAfter(publicSitePath()).data.dueAt == null
        && existsAfter(historyEventPath(turnId))
        && event.type == (terminalStatus == 'expired' ? 'turn_expired' : 'turn_skipped')
        && event.season == 1
        && event.targetContributionNumber == getAfter(turnPath(turnId)).data.targetContributionNumber
        && event.occurredAt == request.time;
    }

    function validOperationalEnd() {
      let turnId = currentTurnIdBefore();
      let turnBefore = get(turnPath(turnId)).data;
      let terminalStatus = request.resource.data.status;
      return resource.data.status == 'active' && terminalStatus in ['expired','skipped']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.updatedAt is timestamp && request.resource.data.updatedAt == request.time
        && turnBefore.githubUserId == resource.data.githubUserId
        && completeTurnEnd(turnId, resource.data.githubUserId, terminalStatus);
    }

    function validPrivateSiteEnd() {
      let turnId = resource.data.activeTurnId;
      let turnAfter = getAfter(turnPath(turnId)).data;
      return turnId is string && request.resource.data.activeTurnId == null
        && request.resource.data.keys().hasAll(['activeTurnId','updatedAt'])
        && request.resource.data.keys().hasOnly(['activeTurnId','updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeTurnId','updatedAt'])
        && request.resource.data.updatedAt is timestamp && request.resource.data.updatedAt == request.time
        && turnAfter.status in ['expired','skipped']
        && completeTurnEnd(turnId, turnAfter.githubUserId, turnAfter.status);
    }

    function validPublicSiteEnd() {
      let before = resource.data;
      let after = request.resource.data;
      let turnId = currentTurnIdBefore();
      let turnAfter = getAfter(turnPath(turnId)).data;
      return before.turnStatus in ['active','submitted','under_review']
        && after.keys().hasAll(['currentVersion','totalContributions','turnStatus','targetContributionNumber','currentContributor','dueAt','updatedAt'])
        && after.keys().hasOnly(['currentVersion','totalContributions','turnStatus','targetContributionNumber','currentContributor','dueAt','updatedAt'])
        && after.currentVersion == before.currentVersion && after.totalContributions == before.totalContributions
        && after.turnStatus == 'none' && after.targetContributionNumber == null
        && after.currentContributor == null && after.dueAt == null
        && after.updatedAt is timestamp && after.updatedAt == request.time
        && turnAfter.status in ['expired','skipped']
        && completeTurnEnd(turnId, turnAfter.githubUserId, turnAfter.status);
    }

    function validPublicPresentation(data) {
      return data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 50
        && data.displayName.matches('^\\S(.*\\S)?$')
        && data.githubUsername is string
        && data.githubUsername.size() >= 1
        && data.githubUsername.size() <= 39
        && data.githubUsername.matches('^[A-Za-z0-9-]+$');
    }

    function validFailureHistoryEvent(eventId) {
      let data = request.resource.data;
      let turnBefore = get(turnPath(eventId)).data;
      let turnAfter = getAfter(turnPath(eventId)).data;
      let contributor = get(contributorPathFor(turnAfter.githubUserId)).data;
      return currentTurnIdBefore() == eventId
        && !exists(historyEventPath(eventId))
        && data.keys().hasAll(['type','season','displayName','githubUsername','targetContributionNumber','occurredAt'])
        && data.keys().hasOnly(['type','season','displayName','githubUsername','targetContributionNumber','occurredAt'])
        && ((turnAfter.status == 'expired' && data.type == 'turn_expired')
          || (turnAfter.status == 'skipped' && data.type == 'turn_skipped'))
        && turnBefore.status in ['active','submitted','under_review']
        && data.season == 1 && data.season == turnAfter.season
        && data.targetContributionNumber == turnAfter.targetContributionNumber
        && validPublicPresentation(data)
        && data.displayName == contributor.displayName
        && data.githubUsername == contributor.githubUsername
        && data.occurredAt is timestamp && data.occurredAt == request.time
        && completeTurnEnd(eventId, turnAfter.githubUserId, turnAfter.status);
    }

    function validContributionSummary(data) {
      return data.summary is string
        && data.summary.size() >= 1 && data.summary.size() <= 160
        && data.summary.matches('^\\S(.{0,158}\\S)?$')
        && (!('contributorMessage' in data)
          || (data.contributorMessage is string
            && data.contributorMessage.size() >= 1
            && data.contributorMessage.size() <= 280
            && data.contributorMessage.matches('^\\S(.{0,278}\\S)?$')));
    }

    function validTurnMerge(turnId) {
      let before = resource.data;
      let after = request.resource.data;
      return currentTurnIdBefore() == turnId
        && before.status == 'under_review' && after.status == 'merged'
        && after.keys().hasAll(['githubUserId','season','status','targetContributionNumber','startedAt','dueAt','prNumber','prUrl','submittedAt','reviewStartedAt','mergedAt','endedAt','createdAt','updatedAt'])
        && after.keys().hasOnly(['githubUserId','season','status','targetContributionNumber','startedAt','dueAt','prNumber','prUrl','submittedAt','reviewStartedAt','mergedAt','endedAt','createdAt','updatedAt'])
        && after.diff(before).affectedKeys().hasOnly(['status','mergedAt','endedAt','updatedAt'])
        && currentTurnBaseIsPreserved(before, after)
        && after.prNumber == before.prNumber && after.prUrl == before.prUrl
        && after.submittedAt == before.submittedAt
        && after.reviewStartedAt == before.reviewStartedAt
        && validPullRequest(after)
        && after.mergedAt is timestamp && after.mergedAt == request.time
        && after.endedAt is timestamp && after.endedAt == request.time
        && after.updatedAt is timestamp && after.updatedAt == request.time
        && completeMerge(turnId, after.githubUserId, after.targetContributionNumber);
    }

    function validOperationalMerge() {
      let turnId = currentTurnIdBefore();
      let turn = getAfter(turnPath(turnId)).data;
      return resource.data.status == 'active'
        && request.resource.data.status == 'completed'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status','contributionNumber','updatedAt'])
        && request.resource.data.githubUserId == resource.data.githubUserId
        && request.resource.data.season == resource.data.season
        && request.resource.data.season == 1
        && request.resource.data.contributionNumber is int
        && request.resource.data.contributionNumber == turn.targetContributionNumber
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time
        && turn.githubUserId == resource.data.githubUserId
        && completeMerge(turnId, turn.githubUserId, turn.targetContributionNumber);
    }

    function validPrivateSiteMerge() {
      let turnId = resource.data.activeTurnId;
      let turn = getAfter(turnPath(turnId)).data;
      return turnId is string
        && request.resource.data.activeTurnId == null
        && request.resource.data.keys().hasAll(['activeTurnId','updatedAt'])
        && request.resource.data.keys().hasOnly(['activeTurnId','updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeTurnId','updatedAt'])
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time
        && turn.status == 'merged'
        && completeMerge(turnId, turn.githubUserId, turn.targetContributionNumber);
    }

    function validPublicSiteMerge() {
      let before = resource.data;
      let after = request.resource.data;
      let turnId = currentTurnIdBefore();
      let turn = getAfter(turnPath(turnId)).data;
      return before.turnStatus == 'under_review'
        && after.keys().hasAll(['currentVersion','totalContributions','turnStatus','targetContributionNumber','currentContributor','dueAt','updatedAt'])
        && after.keys().hasOnly(['currentVersion','totalContributions','turnStatus','targetContributionNumber','currentContributor','dueAt','updatedAt'])
        && after.currentVersion == before.currentVersion + 1
        && after.currentVersion == turn.targetContributionNumber
        && after.totalContributions == before.totalContributions + 1
        && after.turnStatus == 'none' && after.targetContributionNumber == null
        && after.currentContributor == null && after.dueAt == null
        && after.updatedAt is timestamp && after.updatedAt == request.time
        && completeMerge(turnId, turn.githubUserId, turn.targetContributionNumber);
    }

    function validContributionCreate(contributionDocument) {
      let data = request.resource.data;
      let turnId = currentTurnIdBefore();
      let turn = getAfter(turnPath(turnId)).data;
      let contributor = get(contributorPathFor(turn.githubUserId)).data;
      return contributionDocument == string(data.number)
        && !exists(contributionPath(data.number))
        && data.keys().hasAll(['number','season','displayName','githubUsername','summary','prNumber','prUrl','mergedAt','createdAt'])
        && data.keys().hasOnly(['number','season','displayName','githubUsername','summary','contributorMessage','prNumber','prUrl','mergedAt','createdAt'])
        && data.number is int && data.number > 0
        && data.number == turn.targetContributionNumber
        && data.season == 1 && data.season == turn.season
        && validPublicPresentation(data) && validContributionSummary(data)
        && data.displayName == contributor.displayName
        && data.githubUsername == contributor.githubUsername
        && data.prNumber == turn.prNumber && data.prUrl == turn.prUrl
        && validPullRequest(data)
        && data.mergedAt is timestamp && data.mergedAt == request.time
        && data.createdAt is timestamp && data.createdAt == request.time
        && completeMerge(turnId, turn.githubUserId, data.number);
    }

    function validContributionHistoryEvent(eventId) {
      let data = request.resource.data;
      let turn = getAfter(turnPath(eventId)).data;
      let contribution = getAfter(contributionPath(turn.targetContributionNumber)).data;
      return currentTurnIdBefore() == eventId
        && !exists(historyEventPath(eventId))
        && data.keys().hasAll(['type','season','displayName','githubUsername','targetContributionNumber','contributionNumber','occurredAt'])
        && data.keys().hasOnly(['type','season','displayName','githubUsername','targetContributionNumber','contributionNumber','occurredAt'])
        && data.type == 'contribution' && data.season == 1
        && data.targetContributionNumber == turn.targetContributionNumber
        && data.contributionNumber == turn.targetContributionNumber
        && validPublicPresentation(data)
        && data.displayName == contribution.displayName
        && data.githubUsername == contribution.githubUsername
        && data.occurredAt is timestamp && data.occurredAt == request.time
        && completeMerge(eventId, turn.githubUserId, turn.targetContributionNumber);
    }

    function completeMerge(turnId, id, number) {
      let turn = getAfter(turnPath(turnId)).data;
      let contribution = getAfter(contributionPath(number)).data;
      let event = getAfter(historyEventPath(turnId)).data;
      let publicSite = getAfter(publicSitePath()).data;
      return !exists(contributionPath(number))
        && !exists(historyEventPath(turnId))
        && turn.status == 'merged'
        && turn.githubUserId == id && turn.targetContributionNumber == number
        && getAfter(participationPathFor(id)).data.status == 'completed'
        && getAfter(participationPathFor(id)).data.contributionNumber == number
        && getAfter(queuePathFor(id)).data.status == 'completed'
        && getAfter(queuePathFor(id)).data.contributionNumber == number
        && getAfter(privateSitePath()).data.activeTurnId == null
        && publicSite.turnStatus == 'none'
        && publicSite.currentVersion == number
        && publicSite.totalContributions == get(publicSitePath()).data.totalContributions + 1
        && publicSite.currentContributor == null
        && publicSite.targetContributionNumber == null && publicSite.dueAt == null
        && existsAfter(contributionPath(number))
        && contribution.number == number
        && contribution.prNumber == turn.prNumber && contribution.prUrl == turn.prUrl
        && existsAfter(historyEventPath(turnId))
        && event.type == 'contribution'
        && event.contributionNumber == number
        && event.targetContributionNumber == number
        && event.occurredAt == request.time;
    }

    match /contributions/{contributionNumber} {
      allow read: if true;
      allow create: if isActiveAdmin() && validContributionCreate(contributionNumber);
      allow update, delete: if false;
    }

    match /historyEvents/{eventId} {
      allow read: if true;
      allow create: if isActiveAdmin()
        && (validFailureHistoryEvent(eventId) || validContributionHistoryEvent(eventId));
      allow update, delete: if false;
    }

    match /site/public {
      allow read: if true;
      allow create: if isActiveAdmin() && validPublicSiteActivation();
      allow update: if isActiveAdmin() && (validPublicSiteActivation() || validPublicCurrentTransition() || validPublicSiteEnd() || validPublicSiteMerge());
      allow delete: if false;
    }

    match /site/admin {
      allow get: if isActiveAdmin();
      allow list: if false;
      allow create: if isActiveAdmin() && validPrivateSiteActivation();
      allow update: if isActiveAdmin() && (validPrivateSiteActivation() || validPrivateSiteEnd() || validPrivateSiteMerge());
      allow delete: if false;
    }

    match /admins/{adminGithubUserId} {
      allow get: if hasGitHubIdentity() && adminGithubUserId == githubUserId();
      allow list, create, update, delete: if false;
    }

    match /contributors/{githubUserIdDocument} {
      allow get: if (hasGitHubIdentity() && githubUserIdDocument == githubUserId())
        || isActiveAdmin();
      allow list: if isActiveAdmin();
      allow create: if hasGitHubIdentity()
        && githubUserIdDocument == githubUserId()
        && isCompleteNewJoin()
        && validContributor(request.resource.data);
      allow update, delete: if false;
    }

    match /participation/{participationDocument} {
      allow get: if (hasGitHubIdentity() && participationDocument == seasonOneDocumentId())
        || isActiveAdmin();
      allow list: if isActiveAdmin();
      allow create: if hasGitHubIdentity()
        && participationDocument == seasonOneDocumentId()
        && isCompleteNewJoin()
        && validParticipation(request.resource.data);
      allow update: if isActiveAdmin() && (validParticipationActivation(participationDocument) || validOperationalEnd() || validOperationalMerge());
      allow delete: if false;
    }

    match /queue/{queueDocument} {
      allow get, list: if isActiveAdmin();
      allow create: if hasGitHubIdentity()
        && queueDocument == seasonOneDocumentId()
        && isCompleteNewJoin()
        && validQueueEntry(request.resource.data);
      allow update: if isActiveAdmin()
        && (validAdminQueuePriorityUpdate() || validQueueActivation(queueDocument) || validOperationalEnd() || validOperationalMerge());
      allow delete: if false;
    }

    match /turns/{turnId} {
      allow read: if isActiveAdmin();
      allow create: if isActiveAdmin()
        && validTurnCreate()
        && completeActivation(turnId, request.resource.data.githubUserId);
      allow update: if isActiveAdmin() && (validTurnSubmission(turnId) || validTurnReview(turnId) || validTurnEnd(turnId) || validTurnMerge(turnId));
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
