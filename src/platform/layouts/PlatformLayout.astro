---
import Navigation from '../components/Navigation';
import SiteStatus from '../components/SiteStatus';
import ContributorSiteStatus from '../components/ContributorSiteStatus';
import { robotsMetaContent } from '../config/site-indexing';
import '../../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'who touched this',
  description = 'one website. one contributor at a time.',
} = Astro.props;
const pageTitle = title === 'who touched this' ? title : `${title} | who touched this`;
const contributorPreview = import.meta.env.MODE === 'contributor'
  || (import.meta.env.DEV && import.meta.env.PUBLIC_CONTRIBUTOR_PREVIEW === 'true');
const robots = robotsMetaContent(import.meta.env.PUBLIC_SITE_INDEXING_ENABLED);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="who touched this" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta
      property="og:image"
      content="https://whotouchedthis.website/brand/website-banner.png"
    />
    <meta
      property="og:image:alt"
      content="who touched this — one website. one contributor at a time."
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://whotouchedthis.website/brand/website-banner.png"
    />
    {robots && <meta name="robots" content={robots} />}
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">skip to content</a>
    <header class="platform-header">
      <Navigation currentPath={Astro.url.pathname} />
      {contributorPreview ? <ContributorSiteStatus /> : <SiteStatus client:load />}
    </header>
    <main id="main-content"><slot /></main>
    <script>
      import { initializeNavigationDropdowns } from '../navigation-dropdown';

      initializeNavigationDropdowns();
    </script>
  </body>
</html>
