{
  "name": "who-touched-this",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:contributor": "PUBLIC_CONTRIBUTOR_PREVIEW=true astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "firebase:emulators": "npm run functions:build && firebase emulators:start --only auth,firestore,storage,functions,hosting,pubsub",
    "firebase:emulators:export": "firebase emulators:export .firebase/emulator-data --force",
    "firebase:emulators:import": "npm run functions:build && firebase emulators:start --only auth,firestore,storage,functions,hosting,pubsub --import=.firebase/emulator-data --export-on-exit=.firebase/emulator-data",
    "functions:build": "npm --prefix functions run build",
    "functions:check": "npm --prefix functions run check",
    "functions:test": "npm --prefix functions test",
    "firebase:rules:test": "firebase emulators:exec --only firestore \"node --test --test-concurrency=1 tests/firestore.rules.test.mjs tests/firestore.lifecycle.rules.test.mjs tests/firestore.invitation.rules.test.mjs tests/firestore.email.rules.test.mjs\"",
    "firebase:storage:rules:test": "firebase emulators:exec --only firestore,storage \"node --test --test-concurrency=1 tests/storage.rules.test.mjs\"",
    "test:auth-state": "node --experimental-strip-types --test tests/github-identity.test.ts",
    "test:admin-queue": "node --experimental-strip-types --test tests/admin-queue-logic.test.ts",
    "test:join-validation": "node --experimental-strip-types --test tests/join-validation.test.ts",
    "test:turn-state": "node --experimental-strip-types --test tests/turn-state.test.ts",
    "test:turn-lifecycle": "node --experimental-strip-types --test tests/turn-lifecycle.test.ts",
    "test:contribution-history": "node --experimental-strip-types --test tests/contribution-history.test.ts",
    "test:invitation": "node --experimental-strip-types --test tests/invitation.test.ts",
    "test:media": "node --experimental-strip-types --test tests/media.test.ts",
    "test:contribution-validator": "node --experimental-strip-types --test tests/contribution-validator.test.mjs tests/ci-workflows.test.mjs",
    "test:contributor": "node --experimental-strip-types --test tests/github-identity.test.ts tests/admin-queue-logic.test.ts tests/join-validation.test.ts tests/turn-state.test.ts tests/turn-lifecycle.test.ts tests/contribution-history.test.ts tests/invitation.test.ts tests/media.test.ts",
    "contribution:validate": "node --experimental-strip-types scripts/validate-contribution.mjs"
  },
  "dependencies": {
    "@astrojs/react": "6.0.4",
    "@astrojs/solid-js": "7.0.2",
    "@astrojs/svelte": "9.0.1",
    "@astrojs/vue": "7.0.2",
    "astro": "7.2.9",
    "firebase": "12.18.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "solid-js": "1.9.15",
    "svelte": "5.56.10",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "firebase-tools": "15.28.2",
    "typescript": "6.0.3"
  }
}
