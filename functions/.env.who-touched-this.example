# Copy to ignored functions/.env.who-touched-this before production Functions deployment.
# These are non-secret Firebase Functions parameter values.
# production functions template
EMAIL_PROVIDER_MODE=resend
APP_ORIGIN=https://whotouchedthis.website
GITHUB_REPOSITORY=jeffsandov6/who-touched-this
GITHUB_BASE_BRANCH=main

# RESEND_API_KEY and GITHUB_WEBHOOK_SECRET belong in Firebase Secret Manager,
# never in this file.

WTT_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com