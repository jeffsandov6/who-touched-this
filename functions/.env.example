# Non-secret Firebase Functions configuration for local development.
# The Functions emulator always uses the local sink unless failure mode is selected.
# local functions / emulator template
EMAIL_PROVIDER_MODE=local
APP_ORIGIN=http://localhost:4321
GITHUB_REPOSITORY=jeffsandov6/who-touched-this
GITHUB_BASE_BRANCH=main

# RESEND_API_KEY is intentionally absent. Configure it with Firebase Secret Manager
# before a future production deployment; never put it in an Astro PUBLIC_* variable.
# GITHUB_WEBHOOK_SECRET is also intentionally absent. Put a synthetic value in
# ignored functions/.secret.local for emulator tests and use Firebase Secret
# Manager for production.
