# Firebase Web app configuration. These values identify the public client app;
# copy this file to .env and obtain the real values from the existing Firebase project.
PUBLIC_FIREBASE_API_KEY=your_web_api_key
PUBLIC_FIREBASE_AUTH_DOMAIN=who-touched-this.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=who-touched-this
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
PUBLIC_FIREBASE_APP_ID=your_web_app_id

# Set to true for local Auth, Firestore, and Hosting emulator development.
PUBLIC_USE_FIREBASE_EMULATORS=false
