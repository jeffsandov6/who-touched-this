rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function hasGitHubIdentity() {
      return request.auth != null
        && request.auth.token.firebase is map
        && request.auth.token.firebase.identities is map
        && request.auth.token.firebase.identities.keys().hasAll(['github.com'])
        && request.auth.token.firebase.identities['github.com'] is list
        && request.auth.token.firebase.identities['github.com'].size() == 1
        && request.auth.token.firebase.identities['github.com'][0] is string
        && request.auth.token.firebase.identities['github.com'][0].matches('^[0-9]+$');
    }

    function githubUserId() {
      return request.auth.token.firebase.identities['github.com'][0];
    }

    function adminPath() {
      return /databases/(default)/documents/admins/$(githubUserId());
    }

    function isActiveAdmin() {
      return hasGitHubIdentity()
        && firestore.exists(adminPath())
        && firestore.get(adminPath()).data.githubUserId == githubUserId()
        && firestore.get(adminPath()).data.active == true
        && (firestore.get(adminPath()).data.role == 'owner'
          || firestore.get(adminPath()).data.role == 'admin');
    }

    function validFounderAssetId(assetId) {
      return assetId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$');
    }

    function validFounderFileName(fileName) {
      return fileName.matches('^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$');
    }

    function validFounderMedia() {
      return request.resource.size > 0
        && request.resource.size <= 500 * 1024 * 1024
        && request.resource.contentType is string
        && request.resource.contentType.matches('^(image|audio|video)/[A-Za-z0-9][A-Za-z0-9.+-]*$');
    }

    function validContributionLabel(label) {
      return label.matches('^[0-9]{3,}$');
    }

    function validSnapshotCaptureId(captureId) {
      return captureId.matches('^[A-Za-z0-9-]{1,100}$');
    }

    function validSnapshotRouteKey(fileName) {
      return fileName.matches('^[A-Za-z0-9_-]{1,180}[.]png$');
    }

    function validSnapshotRouteDirectory(routeKey) {
      return routeKey.matches('^[A-Za-z0-9_-]{1,180}$');
    }

    function validSnapshotTileName(fileName) {
      return fileName.matches('^tile-[0-9]{3}[.]png$');
    }

    function validSnapshotIdentity(label, captureId) {
      return request.resource.metadata.contributionNumber is string
        && request.resource.metadata.contributionNumber.matches('^[0-9]+$')
        && request.resource.metadata.contributionLabel == label
        && request.resource.metadata.captureId == captureId
        && validContributionLabel(label)
        && validSnapshotCaptureId(captureId);
    }

    // Founder media is deliberately public by known object path. Namespace
    // enumeration and every mutation remain private admin operations.
    match /public/canvas/founder/{path=**} {
      allow list: if isActiveAdmin();
    }

    match /public/canvas/founder/{assetId}/{fileName} {
      allow get: if validFounderAssetId(assetId) && validFounderFileName(fileName);
      allow create: if isActiveAdmin()
        && resource == null
        && validFounderAssetId(assetId)
        && validFounderFileName(fileName)
        && validFounderMedia();
      allow update: if false;
      allow delete: if isActiveAdmin()
        && validFounderAssetId(assetId)
        && validFounderFileName(fileName);
    }

    // Finalized visual History is public by known immutable object path. Only an
    // active stable-GitHub-ID admin may stage new archive objects; no browser can
    // enumerate, overwrite, mutate metadata, or delete them.
    match /public/history/contributions/{path=**} {
      allow list: if false;
    }

    match /public/history/contributions/{contributionLabel}/{captureId}/manifest.json {
      allow get: if validContributionLabel(contributionLabel) && validSnapshotCaptureId(captureId);
      allow create: if isActiveAdmin()
        && resource == null
        && validSnapshotIdentity(contributionLabel, captureId)
        && request.resource.size > 0
        && request.resource.size <= 1024 * 1024
        && request.resource.contentType == 'application/json';
      allow update, delete: if false;
    }

    match /public/history/contributions/{contributionLabel}/{captureId}/{side}/{fileName} {
      allow get: if validContributionLabel(contributionLabel)
        && validSnapshotCaptureId(captureId)
        && side in ['before', 'after']
        && validSnapshotRouteKey(fileName);
      allow create: if isActiveAdmin()
        && resource == null
        && validSnapshotIdentity(contributionLabel, captureId)
        && side in ['before', 'after']
        && validSnapshotRouteKey(fileName)
        && request.resource.metadata.side == side
        && request.resource.metadata.routeKey + '.png' == fileName
        && request.resource.metadata.sha256 is string
        && request.resource.metadata.sha256.matches('^[0-9a-f]{64}$')
        && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType == 'image/png';
      allow update, delete: if false;
    }

    match /public/history/contributions/{contributionLabel}/{captureId}/{side}/{routeKey}/{fileName} {
      allow get: if validContributionLabel(contributionLabel)
        && validSnapshotCaptureId(captureId)
        && side in ['before', 'after']
        && validSnapshotRouteDirectory(routeKey)
        && validSnapshotTileName(fileName);
      allow create: if isActiveAdmin()
        && resource == null
        && validSnapshotIdentity(contributionLabel, captureId)
        && side in ['before', 'after']
        && validSnapshotRouteDirectory(routeKey)
        && validSnapshotTileName(fileName)
        && request.resource.metadata.side == side
        && request.resource.metadata.routeKey == routeKey
        && request.resource.metadata.tileIndex is string
        && request.resource.metadata.tileIndex.matches('^[0-9]{1,3}$')
        && request.resource.metadata.sha256 is string
        && request.resource.metadata.sha256.matches('^[0-9a-f]{64}$')
        && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType == 'image/png';
      allow update, delete: if false;
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
