# Owner-only Astro production configuration template.
# Copy to ignored .env.production.local and replace every placeholder.
PUBLIC_FIREBASE_API_KEY=replace_with_firebase_web_api_key
PUBLIC_FIREBASE_AUTH_DOMAIN=who-touched-this.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=who-touched-this
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace_with_numeric_sender_id
PUBLIC_FIREBASE_APP_ID=replace_with_firebase_web_app_id
PUBLIC_FIREBASE_STORAGE_BUCKET=who-touched-this.firebasestorage.app

PUBLIC_USE_FIREBASE_EMULATORS=false
PUBLIC_SITE_INDEXING_ENABLED=false

# Release validation only; Functions use their own project-specific parameter file.
APP_ORIGIN=https://whotouchedthis.website
